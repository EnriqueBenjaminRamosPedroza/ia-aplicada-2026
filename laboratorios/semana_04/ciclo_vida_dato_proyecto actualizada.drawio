<mxfile host="app.diagrams.net">
  <diagram id="ciclo" name="Ciclo de vida">
    <mxGraphModel dx="1414" dy="783" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3" parent="1" style="text;html=1;align=left;fontSize=16;" value="&lt;b&gt;Ciclo de vida del dato – Proyecto clínico&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1200" x="40" y="5" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="1. Captura" vertex="1">
          <mxGeometry height="60" width="140" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;fontSize=10;spacing=4;" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; El recepcionista registra D1 nombre, D2 teléfono, D3 edad y D5 fecha; D4 tipo de sangre llega del laboratorio clínico.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Recepcionista&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Aviso de privacidad visible y consentimiento firmado&lt;br&gt;• Capturar solo D1 a D5" vertex="1">
          <mxGeometry height="330" width="180" x="20" y="190" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="2. Almacenamiento" vertex="1">
          <mxGeometry height="60" width="140" x="240" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;fontSize=10;spacing=4;" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Los archivos CSV con D1 a D5 se guardan en el servidor y en la nube.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Administrador del sistema&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Cifrado en reposo y acceso por rol con doble factor&lt;br&gt;• &lt;font color=&#39;#00802b&#39;&gt;&lt;b&gt;Contrato con el proveedor de nube&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font color=&#39;#00802b&#39;&gt;&lt;b&gt;Plan de respuesta a incidentes con aviso a pacientes&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="180" x="220" y="190" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="3. Uso" vertex="1">
          <mxGeometry height="60" width="140" x="440" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;fontSize=10;spacing=4;" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Se analiza la correlación de riesgo por grupo de edad.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Analista de datos y Responsable clínico&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Uso limitado al fin declarado y registro de accesos&lt;br&gt;• &lt;font color=&#39;#00802b&#39;&gt;&lt;b&gt;Disociar D1 y D2 antes del análisis&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font color=&#39;#00802b&#39;&gt;&lt;b&gt;Registro de riesgos aprobado antes de producción&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font color=&#39;#00802b&#39;&gt;&lt;b&gt;Validación de cada resultado por el Responsable clínico&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font color=&#39;#00802b&#39;&gt;&lt;b&gt;Revisión de representatividad por grupo de edad&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;font color=&#39;#00802b&#39;&gt;&lt;b&gt;Canal para pedir revisión humana de un resultado&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="180" x="420" y="190" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="4. Compartición" vertex="1">
          <mxGeometry height="60" width="140" x="640" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;fontSize=10;spacing=4;" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Se envían datos al servicio de IA en la nube para el análisis.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Líder del proyecto&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Contrato con el proveedor de IA&lt;br&gt;• Anonimización (sin D1 ni D2) antes de enviar" vertex="1">
          <mxGeometry height="330" width="180" x="620" y="190" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="5. Retención" vertex="1">
          <mxGeometry height="60" width="140" x="840" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;fontSize=10;spacing=4;" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Los datos y sus respaldos se conservan durante un plazo definido.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Administrador del sistema&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Plazo de retención documentado y revisión periódica&lt;br&gt;• &lt;font color=&#39;#00802b&#39;&gt;&lt;b&gt;Bloqueo de los datos al vencer el plazo&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="180" x="820" y="190" as="geometry" />
        </mxCell>
        <mxCell id="c14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="6. Eliminación" vertex="1">
          <mxGeometry height="60" width="140" x="1040" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c15" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;fontSize=10;spacing=4;" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Al vencer el plazo se borran los datos y sus copias.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Administrador del sistema&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Borrado seguro y confirmación documentada, incluidas copias en la nube" vertex="1">
          <mxGeometry height="330" width="180" x="1020" y="190" as="geometry" />
        </mxCell>
        <mxCell id="c16" edge="1" parent="1" source="c4" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="c6" value="">
